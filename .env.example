# Vercel AI Gateway. Get one at https://vercel.com/dashboard → AI Gateway.
# Used to route model calls to the selected provider (Anthropic, OpenAI, etc.).
AI_GATEWAY_API_KEY=

# Personal access token used by the agent to call the GitHub REST API.
# Generate at https://github.com/settings/tokens (classic or fine-grained).
# Required scopes depend on which tools you use:
#   - read tools: repo:status, repo:read, notifications, read:user, read:org
#   - write tools: repo (full), write:issues, write:discussion, workflow (for PRs)
# Treat the token as a secret. Never commit it.
GITHUB_TOKEN=
